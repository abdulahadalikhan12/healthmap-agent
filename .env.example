# Copy to .env and fill in. Never commit .env.

# --- LLM provider (OpenAI by default; any OpenAI-compatible endpoint works) ---
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- External validation ---
TAVILY_API_KEY=tvly-...

# --- Paths ---
DATA_RAW_PATH=dataset/VF_Hackathon_Dataset_India_Large.xlsx
DATA_DIR=data

# --- Batch extraction ---
# 0 = all rows. Otherwise process a stratified sample of this size.
EXTRACTION_SAMPLE_SIZE=1000

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=healthmap-agent

# --- CORS for the FastAPI backend (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Databricks (Agent Bricks / Mosaic Vector Search / MLflow 3) ---
# Flip this to 1 to use the Databricks stack instead of FAISS + OpenAI.
USE_DATABRICKS=0
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi-...
# Unity Catalog location for Delta tables (created by notebook 01).
DBX_CATALOG=healthmap
DBX_SCHEMA=facilities
DBX_TABLE=facilities
DBX_EXTRACTIONS_TABLE=facility_extractions
# Mosaic AI Vector Search (created by notebook 02).
DBX_VS_ENDPOINT=healthmap-vs
DBX_VS_INDEX=facilities_vs_index
DBX_VS_PRIMARY_KEY=facility_id
DBX_VS_TEXT_COLUMN=notes
# Model Serving endpoints (Databricks-hosted foundation models).
DBX_FM_ENDPOINT=databricks-meta-llama-3-1-70b-instruct
DBX_EMBED_ENDPOINT=databricks-bge-large-en
# SQL warehouse to read extractions + desert-map aggregates. Required when
# USE_DATABRICKS=1 so the online API reads pre-computed rows without paying
# a per-query LLM cost.
DBX_WAREHOUSE_ID=
